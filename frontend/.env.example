# TrustPulse Frontend Environment Configuration

# Base URL for REST API requests (defaults to '/api' proxied by Vite to the backend)
VITE_API_BASE_URL=/api

# Backend target URL for Vite development proxy (FastAPI server)
VITE_BACKEND_TARGET=http://127.0.0.1:8000

# Custom WebSocket URL (optional, defaults to ws://<host>/ws or wss://<host>/ws)
# VITE_WS_URL=ws://127.0.0.1:8000/ws

# Enable local HTTPS via @vitejs/plugin-basic-ssl (required for testing mobile motion/orientation sensors)
# Set to 'true' when testing on physical mobile devices over local network
VITE_ENABLE_SSL=false
